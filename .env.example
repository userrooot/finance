# Phase 1 scanners only read public market data — no keys needed.
# Paper trading needs no keys. Live trading (python -m arb live) needs TRADE-ONLY keys:
# never enable withdrawals (the bot refuses such keys) and whitelist your VPS IP.
# Live also needs ARB_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY (see docs/GO_LIVE.md).
ARB_LIVE_CONFIRM=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
